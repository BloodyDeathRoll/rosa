[Unit]
Description=Rosa forecast cycle (archive + run --all + publish)
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
# Optional publish secrets (VERCEL_TOKEN / VERCEL_ORG_ID / VERCEL_PROJECT_ID). The leading '-'
# makes the file optional, so the box archives + runs even before publishing is configured.
EnvironmentFile=-%h/.config/rosa/env
# %h = the user's home; repo is cloned to ~/rosa (override with ROSA_REPO in the env)
ExecStart=%h/rosa/deploy/oracle/run-cycle.sh
# archive + run + a prebuilt CDN deploy — still finishes well under the timeout
TimeoutStartSec=600
