{
  "version": 3,
  "routes": [
    {
      "src": "/(.*)",
      "continue": true,
      "headers": {
        "X-Content-Type-Options": "nosniff",
        "X-Frame-Options": "DENY",
        "Referrer-Policy": "strict-origin-when-cross-origin",
        "Permissions-Policy": "geolocation=(self), camera=(), microphone=(), payment=()"
      }
    },
    {
      "src": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "rosa-rust.vercel.app"
        },
        {
          "type": "header",
          "key": "sec-fetch-mode",
          "value": "navigate"
        }
      ],
      "status": 308,
      "headers": {
        "Location": "https://rosa.surf/$1"
      }
    },
    {
      "src": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "www.rosa.surf"
        }
      ],
      "status": 308,
      "headers": {
        "Location": "https://rosa.surf/$1"
      }
    }
  ]
}
